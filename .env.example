# Application Environment Configuration
# Karnataka RTO Document Management System (Personal / Single-Owner)

# Port to run the server on (Default: 3000)
PORT=3000

# Secret key used for signing owner authentication session tokens
SESSION_SECRET="your-secure-random-32-byte-hex-secret-here"

# Path to the persistent SQLite database file
DATABASE_PATH="./data/rto_records.db"

# Path to the private storage directory for client and vehicle documents
UPLOAD_DIR="./data/uploads"

# Path to the directory where database backups are saved
BACKUP_DIR="./data/backups"

# Hosted application URL
APP_URL="http://localhost:3000"
